# Server
PORT=5001
NODE_ENV=development

# MongoDB — local instance. For Atlas, paste your connection string here.
MONGO_URI=mongodb://127.0.0.1:27017/gadisewa

# JWT
JWT_SECRET=
JWT_EXPIRES_IN_SECONDS=604800

# CORS — the Next.js frontend origin
CLIENT_URL=http://localhost:3000

# The backend's own publicly-reachable base URL (eSewa redirects the browser here)
API_BASE_URL=http://localhost:5001

# eSewa ePay v2 — public UAT/sandbox test merchant, safe to commit as a
# default (no real money moves through it). Swap for real merchant
# credentials in production.
ESEWA_MERCHANT_CODE=EPAYTEST
ESEWA_SECRET_KEY=8gBm/:&EnhH.1/q
ESEWA_FORM_URL=https://rc-epay.esewa.com.np/api/epay/main/v2/form

# SMTP — used for password-reset / OTP emails. For Gmail, generate an
# "App Password" (Google Account → Security → 2-Step Verification →
# App Passwords) — a regular Gmail password will not work here.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="GadiSewa <your-address@gmail.com>"
